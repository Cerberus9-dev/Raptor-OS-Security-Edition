#!/bin/sh

set -e

# `lb build` runs this script in place of its own body. Without "noauto" as the
# first argument, calling `lb build` here would redirect straight back into
# this script (infinite recursion). The guard makes that failure mode harmless,
# and the inner `lb build noauto "${@}"` skips the redirect so the real build
# actually runs.
# Note: a plain `sudo lb build` in a directory that has auto/build will still
# end up here and then do the real work via the noauto call below.
if [ "${LB_AUTO_BUILD_RUNNING}" = "true" ]; then
    exit 0
fi

export LB_AUTO_BUILD_RUNNING="true"

lb build noauto "${@}"
