#!/bin/sh
set -e

echo "Executing safe auto/clean script..."

# Clean live-build state
lb clean --purge "${@}"

# Safely remove build output directories if they exist
if [ -d "chroot" ]; then
    sudo rm -rf chroot
fi

if [ -d ".build" ]; then
    sudo rm -rf .build
fi

# Use find -delete to safely clean ISO and intermediate build artifacts without glob overflow
find . -maxdepth 2 \( -name "*.iso" -o -name "*.hybrid.iso" -o -name "*.contents" -o -name "*.zsync" \) -type f -delete

echo "auto/clean completed successfully."
