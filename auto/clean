#!/bin/sh
set -e

echo "Executing safe auto/clean script..."

# Execute standard lb clean step
lb clean --purge "${@}"

# Safely delete chroot cache and temporary clean artifacts without glob expansion overflow
if [ -d "chroot" ]; then
    sudo rm -rf chroot
fi

# Clean build artifacts using find + delete to prevent "Argument list too long" errors
find . -maxdepth 2 \( -name "*.iso" -o -name "*.hybrid.iso" -o -name "*.contents" -o -name "*.zsync" \) -type f -delete

# Safely purge cache directories without expanding massive file lists
if [ -d ".build" ]; then
    sudo rm -rf .build
fi

echo "auto/clean completed successfully."
