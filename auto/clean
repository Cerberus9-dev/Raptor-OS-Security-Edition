#!/bin/sh
set -e

# `lb clean` runs this script in place of its own body. Without "noauto", the
# `lb clean` call below would redirect straight back into this script (infinite
# recursion). The guard makes that failure mode harmless, and the inner
# `lb clean noauto` skips the redirect so the real clean actually runs.
if [ "${LB_AUTO_CLEAN_RUNNING}" = "true" ]; then
    exit 0
fi

export LB_AUTO_CLEAN_RUNNING="true"

echo "Running safe auto/clean..."

# A plain clean (no --purge): it still removes chroot, binary, source and
# staging files, but deliberately keeps cache/ so restored CI caches survive.
# --purge would also wipe cache/ and the marker files lb config depends on.
sudo lb clean noauto "${@}"

# Safely delete directories directly by path name without wildcard expansion
if [ -d "chroot" ]; then
    sudo rm -rf chroot
fi

if [ -d ".build" ]; then
    sudo rm -rf .build
fi

# Clean output ISOs and build artifacts using find + delete
find . -maxdepth 2 \( -name "*.iso" -o -name "*.hybrid.iso" -o -name "*.contents" -o -name "*.zsync" \) -type f -delete

echo "auto/clean completed successfully."
