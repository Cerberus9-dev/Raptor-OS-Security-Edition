#!/usr/sbin/nft -f
# Raptor Security — HARDENED mode firewall ruleset
#
# Spec section 8: same tools/apps as Secure, OS defends itself much more
# aggressively. Differences from secure.nft: no unsolicited ICMP at all,
# rate-limited logging of drops (for the Security Center event feed),
# outbound restricted to a defined set of ports rather than wide open —
# tune raptor_allowed_out_ports below rather than opening output entirely.

table inet raptor_security
delete table inet raptor_security

table inet raptor_security {
    set allowed_out_ports {
        type inet_service
        flags interval
        elements = { 53, 80, 123, 443, 853, 1194, 51820 }
        # 53/853 = DNS/DoT, 80/443 = web, 123 = NTP, 1194 = OpenVPN,
        # 51820 = WireGuard. This is deliberately opinionated — extend via
        # Security Center's network controls rather than editing this file
        # by hand once shipped, so GetStatus() stays in sync with reality.
    }

    chain input {
        type filter hook input priority 0; policy drop;

        iif lo accept
        ct state established,related accept
        ct state invalid drop counter

        # No unsolicited ICMP in Hardened — diagnostics happen via VPN/local
        # tools, not by accepting probes from the network.

        log prefix "raptor-hardened-input-drop: " limit rate 5/minute counter drop
    }

    chain forward {
        type filter hook forward priority 0; policy drop;
    }

    chain output {
        type filter hook output priority 0; policy drop;

        oif lo accept
        ct state established,related accept

        tcp dport @allowed_out_ports accept
        udp dport @allowed_out_ports accept

        log prefix "raptor-hardened-output-drop: " limit rate 5/minute counter drop
    }
}
