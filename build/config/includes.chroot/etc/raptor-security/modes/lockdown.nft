#!/usr/sbin/nft -f
# Raptor Security — LOCKDOWN mode firewall ruleset
#
# Spec section 9: "privacy and isolation are more important than
# convenience." This is a real network kill switch — output is
# default-drop with only loopback, DNS-over-Tor/VPN-tunnel-interface, and
# established/related traffic allowed. Ordinary apps that assume a live
# internet connection WILL stop working; that's expected per spec and
# Security Center must say so plainly when this mode is selected, not
# leave the user to discover it by trial and error.

table inet raptor_security
delete table inet raptor_security

table inet raptor_security {
    chain input {
        type filter hook input priority 0; policy drop;

        iif lo accept
        ct state established,related accept
        ct state invalid drop counter

        counter drop
    }

    chain forward {
        type filter hook forward priority 0; policy drop;
    }

    chain output {
        type filter hook output priority 0; policy drop;

        oif lo accept
        ct state established,related accept

        # Only traffic destined for a VPN or Tor tunnel interface is
        # permitted to originate new connections — this is the actual
        # kill-switch enforcement. tun0/wg0 are the conventional interface
        # names NetworkManager/wg-quick create; if Raptor's VPN Manager
        # names tunnels differently, this set must be kept in sync (ideally
        # generated by VPN Manager rather than hand-maintained — flagging
        # as a follow-up rather than solving here).
        oifname { "tun0", "wg0" } accept

        log prefix "raptor-lockdown-output-drop: " limit rate 5/minute counter drop
    }
}
