#!/usr/bin/env bash
set -euo pipefail

CONF_DIR="/etc/raptor"
mkdir -p "$CONF_DIR"

ACTION="${1:-on}"

if [ "${ACTION,,}" = "on" ]; then
    # Block wireless radios & drop all packet processing
    rfkill block all 2>/dev/null || true
    nft flush ruleset
    nft -f - <<EOF
table inet killswitch {
    chain input { type filter hook input priority 0; policy drop; }
    chain forward { type filter hook forward priority 0; policy drop; }
    chain output { type filter hook output priority 0; policy drop; }
}
EOF
    touch "${CONF_DIR}/killswitch_active"
else
    # Restore wireless radios & re-apply current mode firewall rules
    rfkill unblock all 2>/dev/null || true
    rm -f "${CONF_DIR}/killswitch_active"
    MODE=$(cat "${CONF_DIR}/current_mode" 2>/dev/null || echo "SECURITY")
    /usr/local/bin/raptor-security "${MODE,,}"
fi
