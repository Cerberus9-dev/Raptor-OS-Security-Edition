#!/usr/bin/env bash
set -euo pipefail

CONF_DIR="/etc/raptor"
MODE=$(cat "${CONF_DIR}/current_mode" 2>/dev/null || echo "SECURE")
KILLSWITCH=$([ -f "${CONF_DIR}/killswitch_active" ] && echo "ACTIVE" || echo "INACTIVE")

if nft list ruleset 2>/dev/null | grep -q "table inet filter"; then
    FIREWALL="ENABLED"
else
    FIREWALL="DISABLED"
fi

cat <<EOF
{
  "mode": "${MODE^^}",
  "killswitch": "${KILLSWITCH}",
  "firewall": "${FIREWALL}"
}
EOF
