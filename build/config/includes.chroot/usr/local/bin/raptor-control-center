#!/usr/bin/env python3
import os
import subprocess
import sys
import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gdk, GLib, Gtk


class RaptorControlCenter(Gtk.Window):
    def __init__(self):
        super().__init__(title="Raptor Control Center")
        self.set_default_size(640, 420)
        self.set_border_width(15)
        self.set_position(Gtk.WindowPosition.CENTER)

        # Apply dark theme CSS styling
        self.apply_css()

        # Main Layout Box
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=15)
        self.add(main_box)

        # Header Section
        header_label = Gtk.Label()
        header_label.set_markup(
            "<span size='x-large' weight='bold'>RAPTOR CONTROL CENTER</span>"
        )
        main_box.pack_start(header_label, False, False, 5)

        sub_header = Gtk.Label(
            label="System Security Profile & Anonymity Management"
        )
        main_box.pack_start(sub_header, False, False, 0)

        main_box.pack_start(
            Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL),
            False,
            False,
            5,
        )

        # Status Indicators Frame
        status_frame = Gtk.Frame(label=" System Status ")
        status_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        status_box.set_border_width(10)
        status_frame.add(status_box)

        self.lbl_profile = Gtk.Label(label="Active Profile: Unknown")
        self.lbl_profile.set_xalign(0)
        status_box.pack_start(self.lbl_profile, False, False, 0)

        self.lbl_tor = Gtk.Label(label="Tor Service: Checking...")
        self.lbl_tor.set_xalign(0)
        status_box.pack_start(self.lbl_tor, False, False, 0)

        self.lbl_dnscrypt = Gtk.Label(label="DNSCrypt Proxy: Checking...")
        self.lbl_dnscrypt.set_xalign(0)
        status_box.pack_start(self.lbl_dnscrypt, False, False, 0)

        main_box.pack_start(status_frame, False, False, 5)

        # Profile Switcher Controls
        controls_frame = Gtk.Frame(label=" Operational Profiles ")
        btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        btn_box.set_homogeneous(True)
        btn_box.set_border_width(10)
        controls_frame.add(btn_box)

        btn_security = Gtk.Button(label="Security")
        btn_security.connect(
            "clicked", self.on_profile_clicked, "security"
        )
        btn_box.pack_start(btn_security, True, True, 0)

        btn_hardened = Gtk.Button(label="Hardened")
        btn_hardened.connect(
            "clicked", self.on_profile_clicked, "hardened"
        )
        btn_box.pack_start(btn_hardened, True, True, 0)

        btn_lockdown = Gtk.Button(label="Lockdown")
        btn_lockdown.connect(
            "clicked", self.on_profile_clicked, "lockdown"
        )
        btn_box.pack_start(btn_lockdown, True, True, 0)

        main_box.pack_start(controls_frame, False, False, 5)

        # Refresh button / Auto update
        self.update_status()
        GLib.timeout_add_seconds(5, self.update_status)

    def apply_css(self):
        css = b"""
        window {
            background-color: #1e1e2e;
            color: #cdd6f4;
        }
        frame {
            border: 1px solid #45475a;
            border-radius: 6px;
            font-weight: bold;
        }
        button {
            background-color: #313244;
            color: #cdd6f4;
            border-radius: 4px;
            padding: 8px;
            font-weight: bold;
        }
        button:hover {
            background-color: #45475a;
        }
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

    def on_profile_clicked(self, widget, mode):
        try:
            subprocess.run(
                ["pkexec", "/usr/local/bin/raptor-mode-manager", mode],
                check=True,
            )
            self.lbl_profile.set_markup(
                f"Active Profile: <b>{mode.upper()}</b>"
            )
        except subprocess.CalledProcessError as e:
            self.lbl_profile.set_markup(
                f"Active Profile: <span foreground='red'>Failed to switch to {mode}</span>"
            )

    def check_service(self, service_name):
        try:
            res = subprocess.run(
                ["systemctl", "is-active", service_name],
                capture_output=True,
                text=True,
            )
            return res.stdout.strip() == "active"
        except Exception:
            return False

    def update_status(self):
        tor_active = self.check_service("tor")
        dnscrypt_active = self.check_service("dnscrypt-proxy")

        tor_str = (
            "<span foreground='green'>Active</span>"
            if tor_active
            else "<span foreground='red'>Inactive</span>"
        )
        dnscrypt_str = (
            "<span foreground='green'>Active</span>"
            if dnscrypt_active
            else "<span foreground='red'>Inactive</span>"
        )

        self.lbl_tor.set_markup(f"Tor Service: {tor_str}")
        self.lbl_dnscrypt.set_markup(f"DNSCrypt Proxy: {dnscrypt_str}")
        return True


if __name__ == "__main__":
    app = RaptorControlCenter()
    app.connect("destroy", Gtk.main_quit)
    app.show_all()
    Gtk.main()
