[Unit]
Description=Raptor Security Emergency Shutdown Manager
Documentation=https://github.com/Cerberus9-dev/Raptor-OS-Security-Edition
After=dbus.service

[Service]
Type=dbus
BusName=org.raptor.EmergencyShutdown
ExecStart=/usr/bin/raptor-emergency-shutdownd
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
