[Unit]
Description=Raptor Security VPN Manager
Documentation=https://github.com/Cerberus9-dev/Raptor-OS-Security-Edition
After=dbus.service NetworkManager.service
Requires=NetworkManager.service

[Service]
Type=dbus
BusName=org.raptor.VPNManager
ExecStart=/usr/bin/raptor-vpn-managerd
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
