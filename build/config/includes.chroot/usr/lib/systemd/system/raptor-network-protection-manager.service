[Unit]
Description=Raptor Security Network Protection Manager
Documentation=https://github.com/Cerberus9-dev/Raptor-OS-Security-Edition
After=dbus.service NetworkManager.service
Requires=NetworkManager.service

[Service]
Type=dbus
BusName=org.raptor.NetworkProtectionManager
ExecStart=/usr/bin/raptor-network-protection-managerd
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
