#!/usr/bin/env bash
set -euo pipefail

# Enable anti-forensics RAM wipe on shutdown
systemctl enable raptor-sdmem.service

# Set default permissions for Raptor executables
chmod 755 /usr/local/bin/raptor-* 2>/dev/null || true

# Set strict permissions on Polkit rule file
if [ -f /etc/polkit-1/rules.d/50-raptor-mode-manager.rules ]; then
  chown root:root /etc/polkit-1/rules.d/50-raptor-mode-manager.rules
  chmod 644 /etc/polkit-1/rules.d/50-raptor-mode-manager.rules
fi

# Ensure LightDM autologin directory exists
mkdir -p /etc/lightdm/lightdm.conf.d
