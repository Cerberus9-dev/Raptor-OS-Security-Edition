#!/bin/sh
# 0300-raptor-thirdparty-tools.hook.chroot
#
# Installs the four pentest tools deliberately left OUT of
# raptor-pentest.list.chroot because they're not in Debian's apt repos
# (see that file's trailing comment for the research behind that call).
#
# DELIBERATELY NOT run with `set -e`: these are four independent,
# best-effort installs of tools from four different upstream sources.
# One failing (a URL changing, a gem server hiccup) should not abort the
# entire live-build — it should install the other three and report
# clearly what didn't make it into the image, so a maintainer checking
# build logs sees exactly what's missing rather than a total build
# failure that obscures which of the four was the actual problem.
#
# NONE of the four installs below have been executed or tested — this
# sandbox has no route to portswigger.net, rapid7's installer, rubygems,
# or PyPI's netexec package (network allowlist only covers a small set
# of domains — see the environment's network_configuration). Written
# from each tool's own documented install method, not verified against
# a real run. Treat first build's log output for this hook as the actual
# test, not this comment.

echo "[raptor-security] installing third-party pentest tools (best-effort)"

INSTALL_LOG="/var/log/raptor-thirdparty-install.log"
: > "$INSTALL_LOG"

log() {
    echo "[raptor-thirdparty] $1" | tee -a "$INSTALL_LOG"
}

# --- Burp Suite Community Edition -----------------------------------
# PortSwigger's documented headless-install pattern: the "latest" download
# URL without a pinned version, run with their installer's silent flags.
# Not pinning a specific version deliberately — PortSwigger doesn't
# publish stable versioned URLs for Community edition the way a
# apt/pip package would; pin this to a specific version query param
# once you've confirmed one against their actual current release.
log "installing Burp Suite Community Edition"
if curl -fsSL "https://portswigger.net/burp/releases/download?product=community&type=Linux" \
        -o /tmp/burpsuite_installer.sh; then
    chmod +x /tmp/burpsuite_installer.sh
    if /tmp/burpsuite_installer.sh -q -dir /opt/BurpSuiteCommunity; then
        ln -sf /opt/BurpSuiteCommunity/BurpSuiteCommunity /usr/local/bin/burpsuite
        log "Burp Suite installed to /opt/BurpSuiteCommunity"
    else
        log "WARNING: Burp Suite installer exited non-zero — not installed"
    fi
    rm -f /tmp/burpsuite_installer.sh
else
    log "WARNING: could not download Burp Suite installer — not installed"
fi

# --- Metasploit Framework --------------------------------------------
# rapid7's own documented one-line installer (msfinstall script).
log "installing Metasploit Framework"
if curl -fsSL \
     https://raw.githubusercontent.com/rapid7/metasploit-omnibus/master/config/templates/metasploit-framework-wrappers/msfupdate.erb \
     -o /tmp/msfinstall; then
    chmod +x /tmp/msfinstall
    if /tmp/msfinstall; then
        log "Metasploit installed"
    else
        log "WARNING: msfinstall exited non-zero — Metasploit may be partially installed or missing"
    fi
    rm -f /tmp/msfinstall
else
    log "WARNING: could not download msfinstall — Metasploit not installed"
fi

# --- WPScan (Ruby gem) ------------------------------------------------
log "installing WPScan"
if apt-get install -y --no-install-recommends \
        ruby ruby-dev libcurl4-openssl-dev make gcc pkg-config >>"$INSTALL_LOG" 2>&1; then
    if gem install wpscan --no-document >>"$INSTALL_LOG" 2>&1; then
        log "WPScan installed via gem"
    else
        log "WARNING: gem install wpscan failed"
    fi
else
    log "WARNING: could not install WPScan's Ruby build dependencies"
fi

# --- NetExec (crackmapexec's maintained fork) ------------------------
log "installing NetExec (crackmapexec replacement)"
if apt-get install -y --no-install-recommends pipx >>"$INSTALL_LOG" 2>&1; then
    # pipx install as root during chroot build puts it in a location that
    # needs to end up on every user's PATH, not just root's — pipx's
    # default behavior installs to root's home, which is wrong for a
    # live image. Install into a shared location explicitly instead.
    export PIPX_HOME=/opt/pipx
    export PIPX_BIN_DIR=/usr/local/bin
    if pipx install netexec >>"$INSTALL_LOG" 2>&1; then
        log "NetExec installed to /usr/local/bin via pipx"
    else
        log "WARNING: pipx install netexec failed"
    fi
else
    log "WARNING: could not install pipx — NetExec not installed"
fi

# --- radare2 (via bookworm-backports, transiently enabled) -----------
log "installing radare2 (from bookworm-backports)"
echo "deb http://deb.debian.org/debian bookworm-backports main contrib non-free non-free-firmware" \
    > /etc/apt/sources.list.d/bookworm-backports-transient.list
if apt-get update >>"$INSTALL_LOG" 2>&1 && \
   apt-get install -y --no-install-recommends -t bookworm-backports radare2 >>"$INSTALL_LOG" 2>&1; then
    log "radare2 installed from bookworm-backports"
else
    log "WARNING: radare2 install from bookworm-backports failed"
fi
# Remove the backports source afterward — this system should default to
# plain bookworm for everything else; leaving backports enabled
# system-wide risks other packages silently resolving to newer,
# less-tested backport versions on a later `apt upgrade`.
rm -f /etc/apt/sources.list.d/bookworm-backports-transient.list
apt-get update >>"$INSTALL_LOG" 2>&1 || true

# --- theHarvester (Kali packages it themselves; Debian has no package,
#     upstream installs via a Python venv) -----------------------------
log "installing theHarvester"
if apt-get install -y --no-install-recommends python3-venv git >>"$INSTALL_LOG" 2>&1; then
    if git clone --depth 1 https://github.com/laramies/theHarvester.git /opt/theHarvester >>"$INSTALL_LOG" 2>&1; then
        python3 -m venv /opt/theHarvester/.venv >>"$INSTALL_LOG" 2>&1
        if /opt/theHarvester/.venv/bin/pip install -r /opt/theHarvester/requirements/base.txt >>"$INSTALL_LOG" 2>&1; then
            cat > /usr/local/bin/theHarvester <<'THEOF'
#!/bin/sh
exec /opt/theHarvester/.venv/bin/python /opt/theHarvester/theHarvester.py "$@"
THEOF
            chmod 755 /usr/local/bin/theHarvester
            log "theHarvester installed to /opt/theHarvester (launcher: theHarvester)"
        else
            log "WARNING: theHarvester pip requirements install failed"
        fi
    else
        log "WARNING: theHarvester git clone failed"
    fi
else
    log "WARNING: could not install python3-venv/git — theHarvester not installed"
fi

# --- bulk_extractor (Kali packages it themselves; Debian has no package,
#     upstream requires building from source) --------------------------
log "installing bulk_extractor"
log "NOTE: this is a C++ source build with real complexity (its own"
log "  README documents a nontrivial dependency list and a submodule-based"
log "  build) — not attempting an automated build here as part of this"
log "  best-effort pass. If wanted, add a proper build step referencing"
log "  https://github.com/simsong/bulk_extractor's own build docs rather"
log "  than a quick apt-based guess. Deliberately skipped, not silently"
log "  failed — this needs someone to actually decide to invest the time."

log "third-party tool install pass complete — see $INSTALL_LOG for details"
log "this log ships inside the built image at $INSTALL_LOG — check it after first boot"
